# Gemini (cloud LLM + optional embeddings). Prefer storing via the app Settings (OS keychain); .env is for dev only.
GEMINI_API_KEY=
KNOT_LLM_MODEL=gemini/gemini-2.5-flash

# Local speech-to-text (faster-whisper). Whisper is NOT served by Ollama.
KNOT_STT_MODEL=small
KNOT_STT_DEVICE=auto

# Ollama (local embeddings + optional offline LLM fallback)
OLLAMA_HOST=http://127.0.0.1:11434
KNOT_EMBED_MODEL=nomic-embed-text

# Notion MCP (internal integration token; page/db must be shared with the integration)
NOTION_TOKEN=
NOTION_MEETINGS_DATABASE_ID=

# App
KNOT_DATA_DIR=./data
KNOT_PORT=8765
